 // STEP 15 CHANGE (1/3): reset_lambdas now fires only when NONE of the three transmission sources exist
 // (no current infected deer, no 365-day environmental history, no carcasses in the cell).
 // Before (Step 14) it fired whenever number_of_infected_deer = 0, wiping lambda_E* and lambdaC
 // that should be preserved when environmental history or carcasses were still present.
 reflex reset_lambdas when: is_susceptible and my_cell.number_of_infected_deer = 0 and my_cell.total_infected_deer_last_365_days = 0 and my_cell.number_of_carcasses = 0 and (lambda_Gf > 0.0 or lambda_Gm > 0.0 or lambda_Ef > 0.0 or lambda_Em > 0.0 or lambda_Efa > 0.0 or lambdaC > 0.0) {
    // Only reset stale risk values when the deer has no active source of infection in its cell.
    // This avoids assigning zero to every susceptible deer at every cycle.
    lambda_Gf <- 0.0;
    lambda_Gm <- 0.0;
    lambda_Ef <- 0.0;
    lambda_Em <- 0.0;
    lambda_Efa <- 0.0;
    lambdaC <- 0.0;
}
 
// STEP 15 CHANGE (2/3): a susceptible deer computes risk when ANY source exists:
// current infected deer (direct/group), 365-day environmental history, or carcasses.
// lambda_G* depends only on current infected deer; lambda_E* on the 365-day history; lambdaC on carcasses.
reflex calculate_infection_probability_parameters when: (is_susceptible and (my_cell.number_of_infected_deer >= 1 or my_cell.total_infected_deer_last_365_days > 0 or my_cell.number_of_carcasses > 0)) {
	float t0 <- profile_timers ? machine_time : 0.0;

	// STEP 19 CHANGE (3/4): group composition is read from the per-cell cache (ensure_group_stats) instead of
	// filtering my_cell.MD_agents1 and looping over the group for every susceptible deer (O(n^2) per cell).
	// Same quantities and formulas as Step 16-18. Direct transmission needs a real group (my_group != nil) and at least one infected deer in the cell.
	int nM <- 0;
	int iM <- 0;
	int nF <- 0;
	int iF <- 0;
	int nFa <- 0;
	int iFa <- 0;
	if my_group != nil and my_cell.number_of_infected_deer >= 1 {
		ask my_cell { do ensure_group_stats; }
		map<string, list<int>> gs <- my_cell.group_stats;
		if gs contains_key my_group {
			list<int> st <- gs[my_group];
			nM <- st[0];
			iM <- st[1];
			nF <- st[2];
			iF <- st[3];
			nFa <- st[4];
			iFa <- st[5];
		}
	}

	// Continue with transmission calculations
	lambdaC <- beta_c * rho * my_cell.number_of_carcasses;

	lambda_Gf <- (
		beta_per_day * beta_group_scale * (
			delta_mf * iM / max(1, nM)
			+
			delta_ff * (iF + iFa) / max(1, nF + nFa)
		)
	);

	lambda_Gm <- (
		beta_per_day * beta_group_scale * (
			delta_mm * iM / max(1, nM)
			+
			delta_fm * (iF + iFa) / max(1, nF + nFa)
		)
	);

	// Lambda calculations for environmental transmission.
	// Environmental pressure is read directly from the cell instead of being assigned
	// to every susceptible deer by the grid each day.
	// STEP 23: environmental source = infected deer-days in the last 365 days (ODD) or the accumulated pool; multiplied by env_pressure_scale
	float env_source <- (env_pool_halflife_days > 0.0) ? my_cell.env_pool : (my_cell.total_infected_deer_last_365_days * (env_window_normalize ? (365.0 / env_window_days) : 1.0)); // STEP 24: load includes carcass-days; optional normalisation for longer windows
	environmental_infection_pressure <- env_pressure_scale * env_source;
	lambda_Ef <- beta_prime_per_day * food_consumption_rate_f * environmental_infection_pressure;
	lambda_Em <- beta_prime_per_day * food_consumption_rate_m * environmental_infection_pressure;
	lambda_Efa <- beta_prime_per_day * food_consumption_rate_fa * environmental_infection_pressure;
	if profile_timers { prof_lambda <- prof_lambda + (machine_time - t0); }
}
	
