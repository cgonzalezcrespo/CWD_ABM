reflex update_infected_deer_history {
	float t0 <- profile_timers ? machine_time : 0.0;
    // STEP 24: rolling sum over the last env_window_days days (O(1) per cell and day). The value entering the window each day is the
    // environmental load of the day = infectious deer present + carcass_env_weight x carcasses present in the cell
    // (carcass-days until scavengers consume the carcass; prions left in the soil). env_window_days = 365 reproduces the 1-year window; 730 gives 2 years.
    if not infected_history_initialized {
        infected_deer_count_history_last_365 <- list_with(env_window_days, 0.0);
        env_carcass_history <- list_with(env_window_days, 0.0);
        infected_history_index <- 0;
        total_infected_deer_last_365_days <- 0.0;
        env_carcass_load_window <- 0.0;
        env_pool <- 0.0;
        infected_history_initialized <- true;
    }
    float env_in_carc <- carcass_env_weight * number_of_carcasses;
    float env_in_total <- number_of_infected_deer + env_in_carc;
    float old_env_total <- infected_deer_count_history_last_365[infected_history_index];
    float old_env_carc <- env_carcass_history[infected_history_index];
    total_infected_deer_last_365_days <- total_infected_deer_last_365_days - old_env_total + env_in_total;
    env_carcass_load_window <- env_carcass_load_window - old_env_carc + env_in_carc;
    // clamp rounding residues so that "load = 0" tests stay valid
    if total_infected_deer_last_365_days < 0.000001 { total_infected_deer_last_365_days <- 0.0; }
    if env_carcass_load_window < 0.000001 { env_carcass_load_window <- 0.0; }
    infected_deer_count_history_last_365[infected_history_index] <- env_in_total;
    env_carcass_history[infected_history_index] <- env_in_carc;
    if env_pool_halflife_days > 0.0 {
        // exponentially decaying pool (alternative to the window); at constant load it converges to 365 x load
        env_pool <- env_pool * env_pool_decay + (1.0 - env_pool_decay) * 365.0 * env_in_total;
    }
    infected_history_index <- infected_history_index + 1;
    if infected_history_index >= env_window_days {
        infected_history_index <- 0;
    }
	if profile_timers { prof_history <- prof_history + (machine_time - t0); }
}

//Some diffusion to other cells based on prevalence 
reflex rut_visits when: (male_visit_prob > 0.0 and PDseasons = "R" and number_of_infected_deer >= 1) {
	// STEP 25: during the rut each adult/old male that belongs to a group contacts, with probability male_visit_prob per day, one random other group of the cell.
	// Same contact structure as inside a group (FD with delta_mm, delta_fm, delta_mf; visitor counted as one extra male when it infects):
	//  - susceptible visitor: lambda = beta*scale*factor*(delta_mm*I_m/N_m + delta_fm*(I_f+I_fa)/(N_f+N_fa)) with the composition of the visited group
	//  - infectious visitor: each susceptible member of the visited group: beta*scale*factor*delta/(N_m+1), delta_mm for males and delta_mf for females and fawns.
	do ensure_group_stats;
	list<string> gids <- group_stats.keys;
	if length(gids) >= 2 {
		list<mule_deer> visitors <- MD_agents1 where (not dead(each) and each.is_male and each.my_group != nil and (each.state = "Adult" or each.state = "Old") and not each.is_solitary);
		loop v over: visitors {
			if flip(male_visit_prob) {
				string own_group <- v.my_group;
				string target_group <- one_of(gids - [own_group]);
				if target_group != nil {
					list<int> st <- group_stats[target_group];
					float base_rate <- beta_per_day * beta_group_scale * male_visit_factor;
					if v.is_susceptible {
						float lam_visitor <- base_rate * ((delta_mm * st[1] / max(1, st[0])) + (delta_fm * (st[3] + st[5]) / max(1, st[2] + st[4])));
						if flip(lam_visitor) {
							ask v { do exposition_cwd; }
							VISIT_E <- VISIT_E + 1;
						}
					} else if v.is_infected {
						float lam_to_male <- base_rate * delta_mm / (st[0] + 1.0);
						float lam_to_female <- base_rate * delta_mf / (st[0] + 1.0);
						list<mule_deer> members <- MD_agents1 where (not dead(each) and each.my_group = target_group and each.is_susceptible);
						loop m over: members {
							if flip(m.is_male ? lam_to_male : lam_to_female) {
								ask m { do exposition_cwd; }
								VISIT_E <- VISIT_E + 1;
							}
						}
					}
				}
			}
		}
	}
}

