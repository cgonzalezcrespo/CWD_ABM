model CWDCAv3

global {
  // ===== STEP 28 (FINAL, FROZEN VERSION): defaults of the calibrated configuration =====
  // lambda_E: env_pressure_scale 0.11, 730-day window normalised, carcass_env_weight 5; rut visits 0.2; winter fidelity 0.8 (radius 2 cells);
  // fawn_dies_with_mother false; all legacy_* false; drought intensity 5-15% per event; annual hunting quota ~2,275 deer (hunting_quota_target); SimLeng 3650 (10 years).
  // Changes with respect to the ODD are listed in the project notes (Old mortality, exponential carcass persistence, annual reproduction/dispersal, fawn mortality, etc.).
  // ==============================================================================
  // ===== STEP 21: demographic diagnosis switches =====
  // legacy_* = true reproduces the behaviour that Step 17 had BEFORE the Step 18 demographic fixes; false = Step 18/19 (ODD-aligned).
  // They only matter for the demographic comparison; default (all false/true as below) = Step 19 behaviour.
  bool legacy_reproduction <- false;   // true: daily flip of r/35 (realised annual probability 0.45/0.59/0.55 instead of 0.60/0.87/0.80)
  bool legacy_dispersal <- false;      // true: yearlings flip every day of the reproduction season (practically 100% disperse)
  bool legacy_old_mortality <- false;  // true: no natural mortality in Old (negative probability was never true), only the 16-year cutoff
  bool legacy_fawn_mortality <- false; // true: mortality_rate_fawnS*max(1,N/0.85K)/182.5 with the once-a-year seasonal rate
  bool legacy_hunting <- false;        // true: hunting window 213-305 (93 days) and per-day biases computed only once at creation
  bool legacy_year_length <- false;    // true: 364-step year ((d+1) mod 365, min 1)
  bool fawn_dies_with_mother <- false; // STEP 22 default false (ODD-faithful, near-stable demography). true = Step 15-21 rule (not in the ODD): a fawn dies when its mother dies; false = orphans are adopted by a random doe
  bool outbreak_enabled <- true;       // false = demographic control runs without CWD
  int epi_every <- 90;                 // STEP 22: period (cycles) of the epidemiological time series CSV
  int total_births <- 0;               // cumulative number of births
  int deaths_orphan <- 0;              // cumulative fawns dead because the mother died
  int deaths_hunting <- 0;             // STEP 21b: cumulative deaths by regular hunting (total_hunted only counts the CWD management harvest)
  // ====================================================
 //TO MODIFY THE SIMULATION
  //float seed <- int(1) + 1.0;//16.0 is usually a good outbreak
  //float leng_simu <-7.8; //Length of the simulation in years
  int starting_day <- 135;
  string seasons<- "spring";
  string PDseasons<- "LG";
  string DCUs<-"OTB"; // one_of ("CT", "NE", "NW", "SE", "WT");//
  float pop_scale <-  (1.0);//one_of (0.25,0.5,1.0);//
  int outbreak_day <- 138; // 15th May
  int outbreak_cell <- 330;
  int outbreak_cell2 <- 262; 
  bool ExportSim <- true;//reflex SaveData
  bool Export_end<-true; //reflex SaveDataEnd
  bool disease_management<-false;
 //date starting_date <- date([2024,7,1,1,0,0]);
  
  //files
  file WEI <- file("../includes/"+ string(DCUs)+"/ARweigscale.asc");
  file K <- file("../includes/"+ string(DCUs)+"/ARK2024.asc");
  file ABU <- file("../includes/"+ string(DCUs)+"/ARabund.asc");
  file RNG <- file("../includes/"+ string(DCUs)+"/ARRangeN.asc");
  file MigraN <- file("../includes/"+ string(DCUs)+"/ARMigraN.asc");
  //file HUNTING <- file("../includes/"+ string(DCUs)+"/ARHunt.asc");
  file SCAV <- file("../includes/"+ string(DCUs)+"/ARScav.asc");
  // Parameters for the global environment
  geometry shape <- envelope(WEI);
  map<grid_agent, float> cell_weights;
  int current_daysim <- starting_day update:(legacy_year_length ? ((current_daysim + 1) mod 365) : ((current_daysim mod 365) + 1)) min: 1; // STEP 21: switch legacy_year_length; // STEP 18 CHANGE: 365-day year (was (d+1) mod 365 min 1, i.e. 364 steps)
  int total_days update: int (time / #day) min:1;
  float step <- 1 #day;
  //int SimLeng<- int(365*leng_simu); //
  int SimLeng<- int(3650); // STEP 28: 10 years (was 1825) // 1825 int(1095);1095 3 years---1368 days are 3 years and 9 months
  int spring_start <- 105; // Day of the year when spring migration starts
  int fall_start <- 288; // Day of the year when fall migration starts
  int summer_start<-171;
  int winter_start<-354;
  int LG_start <- 91;
  int F_start <- 136;
  int PR_start <- 213;
  int R_start <- 305;
  int EG_start <- 350;
  // STEP 18 CHANGE: hunting season per ODD (Aug 14 - Nov 7); pressure is divided over the days actually simulated
  int hunt_start <- legacy_hunting ? 213 : 226; // 213 = PR_start (legacy)
  int hunt_end <- legacy_hunting ? 305 : 311;   // 305 = R_start (legacy)
  int hunt_days <- (hunt_end - hunt_start) + 1;
  // STEP 19: timing instrumentation (set profile_timers <- false to disable). Times are cumulative milliseconds per block;
  // 'prof_cycle' is the wall time between consecutive cycles, so (prof_cycle - sum of blocks) is the cost of the deer FSM states and the rest.
  bool profile_timers <- false; // STEP 28: off by default (set true to write the timing CSV)
  int profile_every <- 30;
  float prof_last_time <- 0.0;
  float prof_cycle <- 0.0;
  float prof_lists <- 0.0;
  float prof_counters <- 0.0;
  float prof_history <- 0.0;
  float prof_diffusion <- 0.0;
  float prof_carcass <- 0.0;
  float prof_ktrunc <- 0.0;
  float prof_migration <- 0.0;
  float prof_hunting <- 0.0;
  float prof_lambda <- 0.0;
  float prof_move <- 0.0;
  // STEP 19 CHANGE (1/4): per-cycle index of deer and carcasses by cell, built once per cycle with group_by
  int index_cycle <- -1;
  map<grid_agent, list<mule_deer>> deer_by_cell <- [];
  map<grid_agent, list<carcass>> carcass_by_cell <- [];
  bool drought <- false;
  int drought_period;
  int drought_days;
  bool fire_season;
  float fire_p<-0.015;
  float fire_probability <- 0.015;//one_of(fire_p/2,firep_p,fire_p*2,fire_p*3);
  float fire_probabilityS;
  float bigfire_p <- 0.0028;
  float drought_p <- 0.2;
  int year<- 365;
  float cell_area_km2 <- 100.0;
  // STEP 23: lambda_E = env_pressure_scale * beta'/365 * phi * (infected deer-days in the last 365 days, or env_pool if env_pool_halflife_days > 0).
  // 1.0 = literal ODD Eq. 13-15 (Step 20); 0.01 reproduces Steps 14-19 (pressure divided by cell_area_km2 = 100).
  float env_pressure_scale <- 0.11; // STEP 28: calibrated value (1.0 = literal ODD, 0.01 = Steps 14-19)
  bool env_scale_random <- false;       // true: env_pressure_scale is drawn log-uniformly in [env_scale_min, env_scale_max] at the start of each simulation (plausible-range / ABC ensembles)
  float env_scale_min <- 0.01;
  float env_scale_max <- 0.3;
  // STEP 23: optional accumulation of prions in the environment. > 0 replaces the 365-day window by a per-cell pool with this half-life (days); 0 = ODD window
  float env_pool_halflife_days <- 0.0;
  float env_pool_decay <- 0.0;          // computed in init
  // STEP 24: environmental load = infectious deer present + carcass_env_weight x carcasses present, summed over the last env_window_days days.
  // A carcass therefore infects in two simultaneous ways: direct contact (lambda_C, while it exists) and prions deposited in the soil (this load, until the window forgets it).
  int env_window_days <- 730; // STEP 28: 2-year memory (prion persistence ~2 years)           // memory of the environmental load (365 = ODD; 730 = 2-year memory). Fixed at the start of each simulation.
  bool env_window_normalize <- true; // STEP 28   // true: window sum x 365/env_window_days (keeps the steady-state pressure of a 1-year window when the window is extended)
  float carcass_env_weight <- 5.0; // STEP 28      // infected-deer-day equivalents contributed by one carcass-day (0 = carcasses do not feed the environmental load)
  float beta_group_scale <- 1.0;        // multiplier of the direct (group) beta; beta from Jennelle already subsumes some indirect transmission
  // STEP 25: contacts of adult/old males with groups other than their own during the rut (PDseasons = "R"), so that the male bias of CWD comes from group contacts.
  float male_visit_prob <- 0.2;         // daily probability that a group-member adult/old male contacts one random OTHER group of its cell during the rut (0 = Step 24 behaviour)
  float male_visit_factor <- 1.0;       // contact intensity of a visit-day relative to a day inside the group (1 = same lambda as within-group contact)
  int VISIT_E <- 0;                     // cumulative exposures caused by rut visits (not included in the EG/EE/EC class counters)
  // STEP 27: fidelity to the winter range of migratory deer (before: every winter a random winter-range cell within 10 cells, i.e. no winter fidelity).
  // Each deer remembers the winter cell of its group; in the next winter it returns there with probability winter_fidelity; otherwise it chooses a random
  // winter-range cell within winter_radius_cells of the remembered one. Deer without memory (first winter) use the former random choice.
  bool legacy_winter_migration <- false; // true = Step 26 behaviour (random winter cell within 10 cells every year)
  float winter_fidelity <- 0.8;          // probability of returning to the remembered winter cell
  int winter_radius_cells <- 2;          // radius (cells; 1 cell = 10 km) of the random choice when the deer does not return to the same cell
  // STEP 28: annual hunting quota. Every year, on the first hunting day, a common factor is applied to the per-cell hunting pressures (huntpress_*)
  // so that the expected number of hunted deer equals hunting_quota_target. 0 = no quota (pressures as in the ODD). The factor is capped at hunting_quota_max_factor.
  float hunting_quota_target <- 2275.0;  // hunted deer per year (adult/old males and females, yearling males)
  float hunting_quota_max_factor <- 2.0; //with 3.0: Los machos adultos y old pasan de ~7,700 en el año 3 a ~4,300 en el año 9, unos 25 por 100 hembras. Hacia el final se caza ~40% de ellos por temporada // upper bound of the factor (per-buck seasonal probability <= 1 - exp(-3 x 0.195) = 0.44)
  float hunt_quota_factor <- 1.0;        // current factor (1 = no scaling)
  // STEP 23: drought intensity (extra mortality) drawn per drought event, uniform in [min, max] (before: fixed +15%)
  float drought_effect_min <- 0.05;
  float drought_effect_max <- 0.15;
  float drought_effect <- 0.0;          // current drought intensity (0 when there is no drought)
  int detected_harvest <- 0;            // STEP 23: cumulative infected deer detected by hunter-harvest surveillance
  
  
  //Reflex to start the outbreak on a specific day and cell grid_agent86
  bool outbreak_started <- false;
  reflex set_hunting_quota when: (hunting_quota_target > 0.0 and current_daysim = hunt_start) {
    // STEP 28: solve for the factor f such that sum_cells n_class * (1 - exp(-f * pressure_class)) = hunting_quota_target
    // (the daily flips over the hunting season give a seasonal probability of 1 - exp(-f * pressure)).
    list<float> nM_l <- [];
    list<float> nF_l <- [];
    list<float> nY_l <- [];
    list<float> pM_l <- [];
    list<float> pF_l <- [];
    list<float> pY_l <- [];
    loop c over: grid_agent {
      add float(length(c.MD_agents1 where (not dead(each) and each.is_male and (each.state = "Adult" or each.state = "Old")))) to: nM_l;
      add float(length(c.MD_agents1 where (not dead(each) and (not each.is_male) and (each.state = "Adult" or each.state = "Old")))) to: nF_l;
      add float(length(c.MD_agents1 where (not dead(each) and each.is_male and each.state = "Yearling"))) to: nY_l;
      add c.huntpress_M to: pM_l;
      add c.huntpress_F to: pF_l;
      add c.huntpress_Y to: pY_l;
    }
    float lo <- 0.0;
    float hi <- hunting_quota_max_factor;
    loop times: 40 {
      float mid <- (lo + hi) / 2.0;
      float expected_deaths <- 0.0;
      loop i from: 0 to: length(nM_l) - 1 {
        expected_deaths <- expected_deaths + nM_l[i] * (1.0 - exp(0.0 - mid * pM_l[i])) + nF_l[i] * (1.0 - exp(0.0 - mid * pF_l[i])) + nY_l[i] * (1.0 - exp(0.0 - mid * pY_l[i]));
      }
      if expected_deaths < hunting_quota_target { lo <- mid; } else { hi <- mid; }
    }
    hunt_quota_factor <- (lo + hi) / 2.0;
  }

  reflex profile_tick when: profile_timers {
    // Columns (STEP 21b): sim id, seed, cycle, n_deer, n_carcass, then cumulative SECONDS: cycle_total, lists, counters, history, diffusion, carcass, ktrunc, migration, hunting, lambda, move
    float now <- machine_time;
    if cycle > 0 { prof_cycle <- prof_cycle + (now - prof_last_time); }
    prof_last_time <- now;
    if cycle > 0 and (cycle mod profile_every = 0) {
      save [int(self), float(seed), cycle, length(mule_deer), length(carcass),
            prof_cycle / 1000.0, prof_lists / 1000.0, prof_counters / 1000.0, prof_history / 1000.0, prof_diffusion / 1000.0,
            prof_carcass / 1000.0, prof_ktrunc / 1000.0, prof_migration / 1000.0, prof_hunting / 1000.0, prof_lambda / 1000.0, prof_move / 1000.0]
        to: "../results/profile_timers_" + string(int(seed)) + ".csv" format: "csv" header: true rewrite: false;
      write "PROFILE cycle " + cycle + " | deer " + length(mule_deer) + " | s/cycle " + (prof_cycle / 1000.0 / cycle) + " | lists " + (prof_lists / 1000.0) + " | counters " + (prof_counters / 1000.0) + " | lambda " + (prof_lambda / 1000.0) + " | move " + (prof_move / 1000.0);
    }
  }

  reflex SaveDemography when: ((cycle mod 365 = 10) or (cycle mod 365 = 50)) {
    // STEP 21b columns: sim id (int(self)), seed, cycle, MD_tot, fawns M/F, yearlings M/F, adults M/F, old M/F, births (cum.), fawns dead with mother (cum.), hunting deaths (cum.), management-harvest hunted (cum.), droughts, cells burnt,
    // then switches (1 = legacy): reproduction, dispersal, old_mortality, fawn_mortality, hunting, year_length, fawn_dies_with_mother, outbreak_enabled
    save [int(self), float(seed), cycle, MD_tot,
          mule_deer count (each.state = "Fawn" and each.is_male), mule_deer count (each.state = "Fawn" and not each.is_male),
          mule_deer count (each.state = "Yearling" and each.is_male), mule_deer count (each.state = "Yearling" and not each.is_male),
          mule_deer count (each.state = "Adult" and each.is_male), mule_deer count (each.state = "Adult" and not each.is_male),
          mule_deer count (each.state = "Old" and each.is_male), mule_deer count (each.state = "Old" and not each.is_male),
          total_births, deaths_orphan, deaths_hunting, total_hunted, droughts, total_cells_burnt,
          (legacy_reproduction ? 1 : 0), (legacy_dispersal ? 1 : 0), (legacy_old_mortality ? 1 : 0), (legacy_fawn_mortality ? 1 : 0),
          (legacy_hunting ? 1 : 0), (legacy_year_length ? 1 : 0), (fawn_dies_with_mother ? 1 : 0), (outbreak_enabled ? 1 : 0), hunt_quota_factor]
      to: "../results/demography_" + string(int(seed)) + ".csv" format: "csv" header: true rewrite: false;
  }

  reflex SaveEpiSeries when: (cycle > 0 and (cycle mod epi_every = 0)) {
    // STEP 22: epidemiological time series every epi_every cycles -> ../results/epi_series_<seed>.csv
    // Columns: sim id, seed, cycle, day of year, MD_tot,
    //  S, E (exposed), I (infectious, includes clinical), clinical,
    //  males, E males, I males, females, E females, I females, bucks (adult+old males), E bucks, I bucks,
    //  prevalence (E+I)/n for males, females and bucks,
    //  cells with infected deer, cells with exposed deer, cells with any exposure so far, cells with environmental history (365 d), cells with carcasses, carcasses now,
    //  spread radius from the outbreak cells (km, centre to centre, of the farthest cell with infected deer),
    //  cumulative exposed, infected, carcasses, then cumulative exposures by route: group (EG), environment (EE), carcass (EC), diffusion,
    //  config: drought now (1/0), cells burnt, env_pressure_scale (STEP 23: replaces the 0/1 flag), fawn_dies_with_mother, drought_p, fire_probability, pop_scale,
    //  STEP 28 extra columns (63-64): hunting_quota_target, current hunting quota factor
    //  STEP 27 extra columns (60-62): legacy_winter_migration (1/0), winter_fidelity, winter_radius_cells
    //  STEP 26 extra columns (56-59): adult+old females (n, exposed, infectious) and their prevalence (E+I)/n; bucks/adult-female ratio = column 21 / column 59
    //  STEP 25 extra columns (53-55): cumulative exposures by male rut visits (VISIT_E), male_visit_prob, male_visit_factor
    //  STEP 24 extra columns (48-52): environmental load summed over cells, carcass part of that load, env_window_days, carcass_env_weight, beta_group_scale
    //  STEP 23 extra columns: drought intensity now, cumulative infected deer detected in harvest, env_pool_halflife_days, cells with >= 5 infected, spread radius (km) of those cells
    list<grid_agent> cells_inf <- grid_agent where (each.number_of_infected_deer > 0);
    list<grid_agent> origins <- grid_agent where ((each.index = outbreak_cell) or (each.index = outbreak_cell2));
    float cell_w <- first(grid_agent).shape.width;
    float spread_cells <- 0.0;
    if (cell_w > 0) and not empty(origins) {
      loop c over: cells_inf {
        float dmin <- min(origins collect (c.location distance_to each.location));
        spread_cells <- max(spread_cells, dmin / cell_w);
      }
    }
    list<grid_agent> cells_inf5 <- grid_agent where (each.number_of_infected_deer >= 5);
    float spread5_cells <- 0.0;
    if (cell_w > 0) and not empty(origins) {
      loop c over: cells_inf5 {
        float dmin5 <- min(origins collect (c.location distance_to each.location));
        spread5_cells <- max(spread5_cells, dmin5 / cell_w);
      }
    }
    // STEP 26: null-safe sums (a single 'target agent is nil' error appeared once in a parallel run with sum_of)
    float env_load_total <- 0.0;
    float env_load_carc <- 0.0;
    loop c2 over: grid_agent {
      if c2 != nil and not dead(c2) {
        env_load_total <- env_load_total + c2.total_infected_deer_last_365_days;
        env_load_carc <- env_load_carc + c2.env_carcass_load_window;
      }
    }
    int nM <- mule_deer count each.is_male;
    int nF <- mule_deer count (not each.is_male);
    int eM <- mule_deer count (each.is_male and each.is_exposed);
    int iM <- mule_deer count (each.is_male and each.is_infected);
    int eF <- mule_deer count ((not each.is_male) and each.is_exposed);
    int iF <- mule_deer count ((not each.is_male) and each.is_infected);
    int nB <- mule_deer count (each.is_male and (each.state = "Adult" or each.state = "Old"));
    int eB <- mule_deer count (each.is_male and (each.state = "Adult" or each.state = "Old") and each.is_exposed);
    int iB <- mule_deer count (each.is_male and (each.state = "Adult" or each.state = "Old") and each.is_infected);
    // STEP 26: adult and old females (comparable with the literature's adult male : adult female prevalence ratio)
    int nAF <- mule_deer count ((not each.is_male) and (each.state = "Adult" or each.state = "Old"));
    int eAF <- mule_deer count ((not each.is_male) and (each.state = "Adult" or each.state = "Old") and each.is_exposed);
    int iAF <- mule_deer count ((not each.is_male) and (each.state = "Adult" or each.state = "Old") and each.is_infected);
    save [int(self), float(seed), cycle, current_daysim, MD_tot,
          mule_deer count each.is_susceptible, mule_deer count each.is_exposed, mule_deer count each.is_infected, mule_deer count each.is_clinical,
          nM, eM, iM, nF, eF, iF, nB, eB, iB,
          (eM + iM) / max(1, nM), (eF + iF) / max(1, nF), (eB + iB) / max(1, nB),
          length(cells_inf), grid_agent count (each.number_of_exposed_deer > 0), grid_agent count (each.nb_expositions > 0),
          grid_agent count (each.total_infected_deer_last_365_days > 0), grid_agent count (each.number_of_carcasses > 0), length(carcass),
          spread_cells * sqrt(cell_area_km2),
          total_exposed, total_infected, total_carcasses,
          (FM_EG + FF_EG + YM_EG + YF_EG + AM_EG + AF_EG + OM_EG + OF_EG),
          (FM_EE + FF_EE + YM_EE + YF_EE + AM_EE + AF_EE + OM_EE + OF_EE),
          (FM_EC + FF_EC + YM_EC + YF_EC + AM_EC + AF_EC + OM_EC + OF_EC),
          DIFF_E,
          (drought ? 1 : 0), total_cells_burnt, env_pressure_scale, (fawn_dies_with_mother ? 1 : 0), drought_p, fire_probability, pop_scale,
          drought_effect, detected_harvest, env_pool_halflife_days, length(cells_inf5), spread5_cells * sqrt(cell_area_km2),
          env_load_total, env_load_carc, env_window_days, carcass_env_weight, beta_group_scale,
          VISIT_E, male_visit_prob, male_visit_factor,
          nAF, eAF, iAF, (eAF + iAF) / max(1, nAF),
          (legacy_winter_migration ? 1 : 0), winter_fidelity, winter_radius_cells,
          hunting_quota_target, hunt_quota_factor]
      to: "../results/epi_series_" + string(int(seed)) + ".csv" format: "csv" header: true rewrite: false;
  }

  reflex start_outbreak when: (outbreak_enabled and current_daysim = outbreak_day and not outbreak_started) {
    ask grid_agent where ((each.index = outbreak_cell) or (each.index = outbreak_cell2)) {
        // STEP 18 CHANGE: ODD seeds the outbreak in an adult male; fall back to any susceptible male if the cell has none
        list<mule_deer> adult_males <- MD_agents1 where (not dead(each) and each.is_male = true and each.is_susceptible and each.state = "Adult");
        if empty(adult_males) {
            adult_males <- MD_agents1 where (not dead(each) and each.is_male = true and each.is_susceptible);
        }
        ask 1 among adult_males {
            do get_infected;
        }
    }

    outbreak_started <- true;
}
  
