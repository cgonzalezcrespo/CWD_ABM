experiment epi_batch2 type: batch repeat: 4 keep_seed: false until: (total_days >= SimLeng) {

	reflex SaveDataEnd {
		int run_id <- 2;

		loop sim over: simulations {
			save [
				run_id,
				sim.seed,
				sim.outbreak_cell,
				sim.outbreak_day,
				sim.MD_tot,
				sim.cycle,
				sim.pop_scale,
				sim.total_hunted,
				sim.droughts,
				sim.fire_probability,
				sim.total_cells_burnt,
				sim.total_exposed,
				sim.total_infected,
				sim.total_carcasses,
				sim.diffusion_R,
				sim.DIFF_E,
				sim.FM_EG, sim.FF_EG, sim.FM_EE, sim.FF_EE, sim.FM_EC, sim.FF_EC,
				sim.YM_EG, sim.YF_EG, sim.YM_EE, sim.YF_EE, sim.YM_EC, sim.YF_EC,
				sim.AM_EG, sim.AF_EG, sim.AM_EE, sim.AF_EE, sim.AM_EC, sim.AF_EC,
				sim.OM_EG, sim.OF_EG, sim.OM_EE, sim.OF_EE, sim.OM_EC, sim.OF_EC
			]
			to: "../results/Epi/End/run_" + string(run_id) + ".csv"
			format: "csv"
			header: true
			rewrite: true;

			run_id <- run_id + 1;
		}
	}
}
